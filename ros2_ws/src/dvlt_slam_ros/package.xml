<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dvlt_slam_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 wrapper for dvlt-slam (VGGT-SLAM with the Deja View backbone)</description>
  <maintainer email="hychan@umich.edu">henry</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- cv_bridge is deliberately NOT a dependency: Jazzy builds it against
       numpy 1.26 and this stack runs numpy 2.x. See conversions.py. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
